# Copy this file to .env and fill in your keys.

# Embeddings and reranking (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v5.0-pro
COHERE_EMBED_DIMENSION=1024
RERANK_ENABLED=true
COHERE_RERANK_MODEL=rerank-v4.0-fast

# Vector database (https://console.weaviate.cloud)
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=WebsiteChunk

# LLM (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Chunking and retrieval
CHUNK_SIZE=2000
CHUNK_OVERLAP=300
RETRIEVE_K=25
TOP_K=5
# 1.0 = vector search only, 0.0 = keyword search only
HYBRID_ALPHA=0.65

# Optional: render JavaScript-heavy pages in a headless browser when the plain HTML has too little text.
# Requires: uv sync --extra browser && uv run crawl4ai-setup
BROWSER_FALLBACK=false
MIN_TEXT_CHARS=500

# How long stored pages are kept. A page is deleted after PAGE_IDLE_MINUTES without a question, or after
# PAGE_MAX_AGE_HOURS even if it is still in use (it is then loaded again on the next question). If more than
# MAX_STORED_CHUNKS are stored, the least recently used pages are removed first.
PAGE_IDLE_MINUTES=15
PAGE_MAX_AGE_HOURS=12
MAX_STORED_CHUNKS=60000
CLEANUP_INTERVAL_SECONDS=60
STATE_DB_PATH=data/state.db
