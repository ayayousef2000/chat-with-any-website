# Copy this file to .env and fill in your keys.

# Embeddings and reranking (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-v5.0-pro
COHERE_EMBED_DIMENSION=1024
RERANK_ENABLED=true
COHERE_RERANK_MODEL=rerank-v4.0-fast

# Vector database (https://console.weaviate.cloud)
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=WebsiteChunk
# Seconds the app waits for Weaviate when it starts. The client's own default is 2, which a slow connection can miss.
WEAVIATE_INIT_TIMEOUT_SECONDS=30

# LLM (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: more keys separated by commas, e.g. GROQ_BACKUP_API_KEYS=key2,key3,key4. GROQ_API_KEY is used until
# Groq says its limit is reached, then the first backup key, then the next, and so on; after the last key the first
# is used again. A key whose limit was reached is skipped until it has recovered.
GROQ_BACKUP_API_KEYS=

# Chunking and retrieval
CHUNK_SIZE=2000
CHUNK_OVERLAP=300
RETRIEVE_K=25
TOP_K=3
# 1.0 = vector search only, 0.0 = keyword search only
HYBRID_ALPHA=0.65

# Optional: render JavaScript-heavy pages in a headless browser when the plain HTML has too little text.
# Requires: uv sync --extra browser && uv run crawl4ai-setup
BROWSER_FALLBACK=false
MIN_TEXT_CHARS=500

# Trying again when a service says "too many requests" or is briefly unavailable. The app waits as long as the
# service asks (up to RETRY_MAX_WAIT_SECONDS per wait and RETRY_BUDGET_SECONDS in total), at most RETRY_ATTEMPTS
# tries per call. A service that asks for a longer wait is not waited for: the user is told how long to wait instead.
RETRY_ATTEMPTS=4
RETRY_MAX_WAIT_SECONDS=20
RETRY_BUDGET_SECONDS=45

# Limits per visitor, so that nobody can use up the free plans of the services. A visitor over a limit is told
# how long to wait. Questions: per minute and per day. Page loads and deletes: per hour. Set RATE_LIMIT_ENABLED
# to false to turn the limits off. Visitors are told apart by their network address; behind a proxy, start uvicorn
# with --proxy-headers and --forwarded-allow-ips, otherwise everyone seems to be the proxy.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASKS_PER_MINUTE=6
RATE_LIMIT_ASKS_PER_DAY=60
RATE_LIMIT_LOADS_PER_HOUR=20

# How long stored pages are kept. A page is deleted after PAGE_IDLE_MINUTES without a question, or after
# PAGE_MAX_AGE_HOURS even if it is still in use (it is then loaded again on the next question). If more than
# MAX_STORED_CHUNKS are stored, the least recently used pages are removed first.
PAGE_IDLE_MINUTES=15
PAGE_MAX_AGE_HOURS=12
MAX_STORED_CHUNKS=60000
CLEANUP_INTERVAL_SECONDS=60
STATE_DB_PATH=data/state.db
